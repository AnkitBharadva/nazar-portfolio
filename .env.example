# Admin passcode — required for the admin sign-in. Change this to a strong
# passcode you choose. NEVER commit a real passcode to the repo.
ADMIN_PASSCODE=changeme-dev-only

# Public site URL — the canonical domain of the deployed site. The sitemap,
# robots.txt, canonical links, OG image URLs and JSON-LD all derive from
# this. MUST be set to the real deployed domain on Vercel (e.g.
# https://your-portfolio.vercel.app); until it is set, those URLs point at
# localhost. Leave commented out for local development.
# NEXT_PUBLIC_SITE_URL=

# Optional. Signs admin session cookies. When unset, the passcode itself is
# used as the signing secret. Set a long random value in production.
# SESSION_SECRET=

# --- GitHub mode (persistent admin edits on Vercel) ---
# When all three are set, admin edits commit the JSON data files (and
# uploaded images) back to this repo via the GitHub Contents API, so edits
# persist and auto-redeploy. When unset, the app uses local JSON files.
# The token needs the `contents: write` permission on this repo
# (a fine-grained personal access token scoped to the repo is enough).
# GITHUB_TOKEN=
# GITHUB_OWNER=AnkitBharadva
# GITHUB_REPO=nazar-portfolio
# GITHUB_BRANCH=main
